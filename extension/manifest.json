{
  "manifest_version": 3,
  "name": "Rep Index Capture",
  "version": "0.4.0",
  "description": "Send RWI threads and Reddit threads/wiki pages you are reading to your own Rep Index. Captures only when you click.",
  "action": {
    "default_title": "Rep Index",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "pageCapture"
  ],
  "host_permissions": [
    "https://forum.replica-watch.info/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://new.reddit.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
